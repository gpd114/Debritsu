<?xml version="1.0" encoding="utf-8"?>
<!--
  Night violet, dark at the top left to bright at the bottom right, with three
  sparkles. The gradient runs across the central 72 units — the part a launcher
  actually shows — so the full range is visible under any mask.
  Source artwork: assets/icon.svg.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="18"
                android:startY="18"
                android:endX="90"
                android:endY="90">
                <item android:offset="0" android:color="#FF1E0F4A" />
                <item android:offset="1" android:color="#FF7C4DEB" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sparkles. -->
    <group android:translateX="29" android:translateY="36" android:scaleX="0.9" android:scaleY="0.9">
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.85"
            android:pathData="M0,-4Q0.6,-0.6 4,0Q0.6,0.6 0,4Q-0.6,0.6 -4,0Q-0.6,-0.6 0,-4z" />
    </group>
    <group android:translateX="81" android:translateY="68" android:scaleX="0.7" android:scaleY="0.7">
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.85"
            android:pathData="M0,-4Q0.6,-0.6 4,0Q0.6,0.6 0,4Q-0.6,0.6 -4,0Q-0.6,-0.6 0,-4z" />
    </group>
    <group android:translateX="77" android:translateY="32" android:scaleX="0.5" android:scaleY="0.5">
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.85"
            android:pathData="M0,-4Q0.6,-0.6 4,0Q0.6,0.6 0,4Q-0.6,0.6 -4,0Q-0.6,-0.6 0,-4z" />
    </group>
</vector>
