                    android:startX="28"
                    android:startY="54"
                    android:endX="47"
                    android:endY="54">
                    <item android:offset="0" android:color="#FF101A15" />
                    <item android:offset="1" android:color="#FF2C4237" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.14"
            android:strokeWidth="1.2"
            android:strokeLineCap="round"
            android:pathData="M44.5,43.5L44.5,64.5" />
