<?xml version="1.0" encoding="utf-8"?>
<!--
  An onigiri lying on its side, which makes it a play button: glossy rice on a
  thicker lavender edge, a shadow on the ground, nori on the flat side, a happy
  face and a scatter of light sesame — a sibling to IPTerebi's Terebi-kun.
  Everything sits inside the 66-unit safe circle of the 108-unit canvas, so no
  launcher mask clips it. Source artwork: assets/icon.svg.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shadow on the ground. -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.32"
        android:pathData="M37,84a20,3.2 0 1,0 40,0a20,3.2 0 1,0 -40,0z" />

    <!-- The rice ball's thick edge, then its face. -->
    <group android:translateY="5">
        <path
            android:fillColor="#9C8BC9"
            android:pathData="M44.8,34.8L71.2,49.2Q80,54 71.2,58.8L44.8,73.2Q36,78 36,68L36,40Q36,30 44.8,34.8z" />
    </group>
    <path android:pathData="M44.8,34.8L71.2,49.2Q80,54 71.2,58.8L44.8,73.2Q36,78 36,68L36,40Q36,30 44.8,34.8z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="33.24"
                android:endX="54"
                android:endY="74.76">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFDCD3F2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Nori, cut to the rice ball's outline. -->
    <group>
        <clip-path android:pathData="M44.8,34.8L71.2,49.2Q80,54 71.2,58.8L44.8,73.2Q36,78 36,68L36,40Q36,30 44.8,34.8z" />
        <path android:pathData="M30,41h13.5v26h-13.5z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="30"
                    android:startY="54"
                    android:endX="43.5"
                    android:endY="54">
                    <item android:offset="0" android:color="#FF15201B" />
                    <item android:offset="1" android:color="#FF2E4238" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Light sesame, kept clear of the face: three above, three below. -->
    <group android:rotation="30" android:pivotX="50" android:pivotY="43.5">
        <path android:fillColor="#CFC3EE" android:fillAlpha="0.55" android:pathData="M49.2,43.5a0.8,1.5 0 1,0 1.6,0a0.8,1.5 0 1,0 -1.6,0z" />
    </group>
    <group android:rotation="-25" android:pivotX="56.5" android:pivotY="45">
        <path android:fillColor="#CFC3EE" android:fillAlpha="0.55" android:pathData="M55.7,45a0.8,1.5 0 1,0 1.6,0a0.8,1.5 0 1,0 -1.6,0z" />
    </group>
    <group android:rotation="65" android:pivotX="62" android:pivotY="47.5">
        <path android:fillColor="#CFC3EE" android:fillAlpha="0.55" android:pathData="M61.2,47.5a0.8,1.5 0 1,0 1.6,0a0.8,1.5 0 1,0 -1.6,0z" />
    </group>
    <group android:rotation="10" android:pivotX="49.5" android:pivotY="64">
        <path android:fillColor="#CFC3EE" android:fillAlpha="0.55" android:pathData="M48.7,64a0.8,1.5 0 1,0 1.6,0a0.8,1.5 0 1,0 -1.6,0z" />
    </group>
    <group android:rotation="-40" android:pivotX="55.5" android:pivotY="65.5">
        <path android:fillColor="#CFC3EE" android:fillAlpha="0.55" android:pathData="M54.7,65.5a0.8,1.5 0 1,0 1.6,0a0.8,1.5 0 1,0 -1.6,0z" />
    </group>
    <group android:rotation="70" android:pivotX="60" android:pivotY="61.5">
        <path android:fillColor="#CFC3EE" android:fillAlpha="0.55" android:pathData="M59.2,61.5a0.8,1.5 0 1,0 1.6,0a0.8,1.5 0 1,0 -1.6,0z" />
    </group>

    <!-- The face: happy eyes, a smile, blushing cheeks. -->
    <path
        android:strokeColor="#2A1466"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M49,51q3,-4 6,0M58,51q3,-4 6,0" />
    <path
        android:strokeColor="#E0457B"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M53.5,56.5q2.5,2.8 5,0" />
    <path
        android:fillColor="#FF6B8B"
        android:fillAlpha="0.7"
        android:pathData="M46.2,57a2.3,2.3 0 1,0 4.6,0a2.3,2.3 0 1,0 -4.6,0zM61.7,57a2.3,2.3 0 1,0 4.6,0a2.3,2.3 0 1,0 -4.6,0z" />
</vector>
