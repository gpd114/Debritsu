        </group>
        <group android:rotation="-15" android:pivotX="60" android:pivotY="47">
            <path android:fillColor="#CFC3EE" android:fillAlpha="0.55" android:pathData="M58.4,47a1.6,0.8 0 1,0 3.2,0a1.6,0.8 0 1,0 -3.2,0z" />
        </group>
        <group android:rotation="40" android:pivotX="67" android:pivotY="53">
