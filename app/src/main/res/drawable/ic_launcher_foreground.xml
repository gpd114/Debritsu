<?xml version="1.0" encoding="utf-8"?>
<!--
  An onigiri lying on its side, which makes it a play button: glossy rice on a
  thicker lavender edge, a shadow on the ground, nori wrapped round the flat
  side, and a happy face — a sibling to IPTerebi's Terebi-kun. Everything sits
  inside the 66-unit safe circle of the 108-unit canvas, so no launcher mask
  clips it. Source artwork: assets/icon.svg.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shadow on the ground. -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.35"
        android:pathData="M37,84.5a20,3.2 0 1,0 40,0a20,3.2 0 1,0 -40,0z" />

    <!-- The rice ball's thick edge, then its face. -->
    <group android:translateY="5">
        <path
            android:fillColor="#9C8BC9"
            android:pathData="M44.8,34.8Q59.4,39.4 71.2,49.2Q80,54 71.2,58.8Q59.4,68.6 44.8,73.2Q36,78 36,68Q33,54 36,40Q36,30 44.8,34.8z" />
    </group>
    <path android:pathData="M44.8,34.8Q59.4,39.4 71.2,49.2Q80,54 71.2,58.8Q59.4,68.6 44.8,73.2Q36,78 36,68Q33,54 36,40Q36,30 44.8,34.8z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="36"
                android:startY="30"
                android:endX="72"
                android:endY="78">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.6" android:color="#FFF4F0FC" />
                <item android:offset="1" android:color="#FFD6CCF0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Everything cut to the rice ball's outline: grains, then the nori. -->
    <group>
        <clip-path android:pathData="M44.8,34.8Q59.4,39.4 71.2,49.2Q80,54 71.2,58.8Q59.4,68.6 44.8,73.2Q36,78 36,68Q33,54 36,40Q36,30 44.8,34.8z" />

